local character_info = require("modules.character.character_information")
local character_state = require("modules.character.character_state")
local character_looks = require("modules.character.character_looks")
local character_actions = require("modules.character.character_actions")
local character_registry = require("modules.character.character_registry")
local character_animation_module = require("modules.character.animation.character_animation")
local character_animation = character_animation_module.new()
local character_controller = require("modules.character.character_controller")
local character_appearance = require("modules.character.character_appearance")
local item_definitions = require("modules.utility.item_definitions")

go.property("is_player", true)
go.property("randomize_on_init", true)
go.property("speed", 150)

local function idle_action(state)
	if state.is_carrying then
		return "carry"
	end
	return "walk"
end

local function tilesource_for(self, action)
	return self[character_actions.property(action)]
end

local function facing_from_vector(direction, fallback)
	if direction.x > 0 then
		return "right"
	elseif direction.x < 0 then
		return "left"
	elseif direction.y > 0 then
		return "up"
	elseif direction.y < 0 then
		return "down"
	end
	return fallback or "down"
end

local function apply_idle(self, reset_layers)
	local action = idle_action(self.state)
	character_animation.reset_animation("#body", tilesource_for(self, action))
	self.current_action = action
	if reset_layers then
		character_appearance.reset(self.state.direction)
	end
	character_animation.play_animation("#body", nil, self.state)
end

local function apply_carrying(self, carrying, item_id)
	self.state.is_carrying = carrying and true or false
	self.state.carry_item_id = item_id or 0
	if not self.state.is_carrying then
		self.state.carry_item_id = 0
	end
	msg.post("carry#character_carry", "update_item", { item_id = self.state.carry_item_id })
	apply_idle(self, true)
end

local function start_tool_action(self, action)
	local tilesource = action and self[action]
	if not tilesource then
		return false
	end
	self.current_action = action
	if self.state.is_carrying then
		msg.post("carry#character_carry", "update_item", { item_id = 0 })
	end
	character_animation.start_animation("#body", tilesource, self.state)
	character_appearance.play_action(action, self.state.direction)
	return true
end

function init(self)
	if self.is_player then
		self.state = character_info
		self.state.is_player = true
		msg.post(".", "acquire_input_focus")
	else
		self.state = character_state.new()
	end
	character_registry.register(go.get_id(), self.state)
	item_definitions.initilize()

	self.dir = vmath.vector3()
	self.move_dir = vmath.vector3()
	self.current_action = "walk"

	if self.randomize_on_init then
		character_looks.randomize(self.state.looks)
	end
	apply_idle(self, true)
end

function final(self)
	character_registry.unregister(go.get_id())
end

function update(self, dt)
	if character_animation.animation_playing or not self.state.can_move then
		return
	end

	local dir = self.dir
	if not self.is_player then
		dir = self.move_dir
	end

	if vmath.length_sqr(dir) > 1 then
		dir = vmath.normalize(dir)
	end

	if dir.x ~= 0 or dir.y ~= 0 then
		self.state.direction = facing_from_vector(dir, self.state.direction)
	end

	local p = go.get_position()
	go.set_position(p + dir * self.speed * dt)

	character_animation.play_animation("#body", dir, self.state)
	character_appearance.animate(dir, self.state.direction)

	if self.is_player then
		self.dir = vmath.vector3()
	end
end

function on_input(self, action_id, action)
	if not self.is_player then
		return
	end

	local result = character_controller.handle_input(self, action_id, action, character_animation.animation_playing, self.state)
	if not result then
		return
	end

	if result.perform_action then
		msg.post("inventory_bar_gui#inventory_bar", "request_selected")
	elseif result.toggle_inventory then
		msg.post("inventory_gui#inventory", "toggle")
	elseif result.toggle_design then
		msg.post("character_design#character_design", "toggle")
	end
end

function on_message(self, message_id, message, sender)
	message = message or {}

	if message_id == hash("reset_animations") or message_id == hash("looks_changed") then
		apply_idle(self, true)
	elseif message_id == hash("set_looks") then
		character_looks.apply(self.state.looks, message.looks or message)
		apply_idle(self, true)
	elseif message_id == hash("randomize_looks") then
		character_looks.randomize(self.state.looks)
		apply_idle(self, true)
	elseif message_id == hash("set_direction") then
		if message.direction then
			self.state.direction = message.direction
			apply_idle(self, true)
		end
	elseif message_id == hash("set_move") then
		self.move_dir.x = message.x or 0
		self.move_dir.y = message.y or 0
		if self.move_dir.x ~= 0 or self.move_dir.y ~= 0 then
			self.state.direction = facing_from_vector(self.move_dir, self.state.direction)
		end
	elseif message_id == hash("set_carrying") then
		local item_id = message.item_id or 0
		local carrying = message.carrying
		if carrying == nil then
			carrying = item_id ~= 0 and item_id ~= -1
		end
		apply_carrying(self, carrying, item_id)
	elseif message_id == hash("play_action") then
		local action = message.action
		if not action and message.item_id then
			local definition = item_definitions.get(message.item_id)
			action = definition and definition.action
		end
		start_tool_action(self, action)
	elseif message_id == hash("set_can_move") then
		self.state.can_move = message.can_move and true or false
	elseif message_id == hash("receive_selected") then
		if character_animation.animation_playing or self.state.is_hovering_gui or not self.state.can_move then
			return
		end

		local item = message.item
		if not item or item.id == -1 then
			return
		end

		local definition = item_definitions.get(item.id)
		start_tool_action(self, definition and definition.action)
	end

	character_animation.on_message(message_id, "#body", tilesource_for(self, idle_action(self.state)), nil, self.state)
	if message_id == hash("animation_done") then
		self.current_action = idle_action(self.state)
		if self.state.is_carrying then
			msg.post("carry#character_carry", "update_item", { item_id = self.state.carry_item_id })
		end
	end
end
